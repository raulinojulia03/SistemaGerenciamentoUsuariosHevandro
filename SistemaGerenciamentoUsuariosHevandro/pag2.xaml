<Window x:Class="WpfApp1.CadastroUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Usuário"
        Height="680"
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid x:Name="CadastroUsuario1">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"
                              Offset="0"/>

                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="850"
                Height="580"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <TextBlock Text="NOVO USUÁRIO"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#3C848A"
                           Margin="35,25,0,0"/>

                <TextBlock Text="Cadastro"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#263238"
                           Margin="35,48,0,0"/>

                <!-- COLUNA ESQUERDA -->

                <TextBlock Text="Nome completo"
                           Margin="35,105,0,0"/>

                <TextBox x:Name="txtNome"
                         Width="330"
                         Height="38"
                         Margin="35,127,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="Usuário"
                           Margin="35,180,0,0"/>

                <TextBox x:Name="txtUsuario"
                         Width="330"
                         Height="38"
                         Margin="35,202,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="E-mail"
                           Margin="35,255,0,0"/>

                <TextBox x:Name="txtEmail"
                         Width="330"
                         Height="38"
                         Margin="35,277,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="Senha"
                           Margin="35,342,0,-12"/>

                <PasswordBox x:Name="txtSenha"
                             Width="330"
                             Height="38"
                             Margin="35,352,0,0"
                             HorizontalAlignment="Left"
                             Padding="10"/>

                <TextBlock Text="Confirmar senha"
                           Margin="35,417,0,-12"/>

                <PasswordBox x:Name="txtConfirmarSenha"
                             Width="330"
                             Height="38"
                             Margin="35,427,0,0"
                             HorizontalAlignment="Left"
                             Padding="10"/>

                <!-- COLUNA DIREITA -->

                <TextBlock Text="Tipo de usuário"
                           Margin="430,105,0,0"/>

                <ComboBox x:Name="cmbTipo"
                          Width="330"
                          Height="38"
                          Margin="430,127,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="Usuario"/>
                    <ComboBoxItem Content="Administrador"/>

                </ComboBox>

                <TextBlock Text="Status"
                           Margin="430,180,0,0"/>

                <ComboBox x:Name="cmbStatus"
                          Width="330"
                          Height="38"
                          Margin="430,202,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="Ativo"/>
                    <ComboBoxItem Content="Inativo"/>

                </ComboBox>

                <TextBlock Text="Avatar"
                           Margin="430,255,0,0"/>

                <ComboBox x:Name="cmbAvatar"
                          Width="330"
                          Height="38"
                          Margin="430,277,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="avatar01.png"/>
                    <ComboBoxItem Content="avatar02.png"/>
                    <ComboBoxItem Content="avatar03.png"/>
                    <ComboBoxItem Content="avatar04.png"/>
                    <ComboBoxItem Content="avatar05.png"/>

                </ComboBox>

                <TextBlock Text="Os avatares são fornecidos pelo sistema."
                           Margin="425,301,5,24"
                           Foreground="#718096"
                           FontSize="12"/>

                <!-- BOTÕES -->

                <Button Content="Cadastrar"
                        Width="180"
                        Height="42"
                        Margin="35,500,0,0"
                        HorizontalAlignment="Left"
                        Background="#3C848A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Cadastrar_Click"/>

                <Button Content="Cancelar"
                        Width="180"
                        Height="42"
                        Margin="230,500,0,0"
                        HorizontalAlignment="Left"
                        Background="White"
                        Foreground="#3C848A"
                        BorderBrush="#3C848A"
                        Click="Cancelar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>