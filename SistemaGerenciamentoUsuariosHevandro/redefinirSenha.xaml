<Window x:Class="WpfApp1.RedefinirSenha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redefinir Senha"
        Height="420"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"/>
                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="400"
                Height="320"
                Background="White"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <TextBlock Text="REDEFINIR SENHA"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#3C848A"
                           Margin="35,25,0,0"/>

                <TextBlock Text="Nova senha"
                           FontSize="25"
                           FontWeight="Bold"
                           Margin="35,50,0,0"/>

                <PasswordBox x:Name="txtSenha"
                             Width="300"
                             Height="40"
                             Margin="35,105,0,0"
                             Padding="10"
                             HorizontalAlignment="Left"/>

                <TextBlock Text="Confirmar senha"
                           Margin="35,160,0,0"/>

                <PasswordBox x:Name="txtConfirmar"
                             Width="300"
                             Height="40"
                             Margin="35,185,0,0"
                             Padding="10"
                             HorizontalAlignment="Left"/>

                <Button Content="Salvar"
                        Width="140"
                        Height="40"
                        Margin="35,245,0,0"
                        HorizontalAlignment="Left"
                        Background="#3C848A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Salvar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>