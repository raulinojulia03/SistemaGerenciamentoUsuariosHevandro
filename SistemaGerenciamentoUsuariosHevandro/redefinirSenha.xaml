<Window x:Class="WpfApp1.RedefinirSenha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redefinir Senha"
        Height="420"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"/>
                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="400"
                Height="320"
                Background="White"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <TextBlock Text="REDEFINIR SENHA"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#3C848A"
                           Margin="35,25,245,275"/>

                <TextBlock Text="Nova senha"
                           FontSize="25"
                           FontWeight="Bold"
                           Margin="35,50,223,236"/>

                <PasswordBox x:Name="txtSenha"
                             Width="202"
                             Margin="35,158,0,125"
                             Padding="10,10"
                             HorizontalAlignment="Left"/>

                <TextBlock Text="Confirmar senha"
                           Margin="35,195,269,107"/>

                <PasswordBox x:Name="txtConfirmar"
                             Width="202"
                             Margin="35,215,0,69"
                             Padding="10,10"
                             HorizontalAlignment="Left"/>

                <Button Content="Salvar"
                        Width="71"
                        Margin="35,281,0,10"
                        HorizontalAlignment="Left"
                        Background="#3C848A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Salvar_Click"/>

            </Grid>

        </Border>
        <TextBlock
            Margin="86,177,356,204"><Run Language="pt-br" Text="Senha"/></TextBlock>

    </Grid>

</Window>