<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Acesso"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid x:Name="telainit">

        <!-- FUNDO -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#DCEFF0"
                              Offset="0"/>
                <GradientStop Color="#F5F8F9"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <!-- CARD CENTRAL -->
        <Border Width="390"
                Height="400"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    ShadowDepth="4"
                    Opacity="0.20"/>
            </Border.Effect>


            <Grid>

                <!-- TÍTULO ACESSO -->
                <Label Content="ACESSO"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,30,0,0"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#3C848A"/>


                <!-- TÍTULO PRINCIPAL -->
                <Label Content="Entrar"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,55,0,0"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#263238"/>


                <!-- DESCRIÇÃO -->
                <Label Content="Informe seu usuário e senha para continuar."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,100,0,0"
                       FontSize="13"
                       Foreground="#718096"/>


                <!-- USUÁRIO -->
                <Label Content="Usuário"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="45,145,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#37474F"/>


                <TextBox x:Name="txt_user"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="45,170,0,0"
                         Width="300"
                         Height="40"
                         FontSize="14"
                         Padding="10,0"
                         Background="#F7F9FA"
                         BorderBrush="#D5DEE2"
                         BorderThickness="1"/>


                <!-- SENHA -->
                <Label Content="Senha"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="45,220,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#37474F"/>


                <PasswordBox x:Name="txt_pass"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="45,245,0,0"
                             Width="300"
                             Height="40"
                             FontSize="14"
                             Padding="10,0"
                             Background="#F7F9FA"
                             BorderBrush="#D5DEE2"
                             BorderThickness="1"/>


                <!-- BOTÃO ENTRAR -->
                <Button x:Name="___Entrar_"
                        Content="Entrar"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="45,300,0,0"
                        Width="300"
                        Height="42"
                        Click="Button_Click"
                        Background="#3C848A"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>


                <!-- NÃO TEM CONTA -->
                <Label Content="Não tem conta?"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="100,355,0,0"
                       FontSize="12"
                       Foreground="#718096"/>


                <!-- CADASTRO -->
                <Button x:Name="cadastro"
                        Content="Cadastre-se"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="199,355,0,0"
                        Width="105"
                        Height="30"
                        Click="Cadastro_Click_1"
                        Background="Transparent"
                        Foreground="#3C848A"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand" RenderTransformOrigin="0.514,0.867"/>

            </Grid>

        </Border>

    </Grid>
</Window>