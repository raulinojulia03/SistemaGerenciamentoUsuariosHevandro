<Window x:Class="WpfApp1.TelaUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuários"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"
                              Offset="0"/>

                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <!-- CABEÇALHO -->

        <TextBlock Text="Usuários"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#263238"
                   Margin="30,25,0,0"/>

        <TextBlock Text="Gerenciamento de usuários cadastrados"
                   FontSize="14"
                   Foreground="#718096"
                   Margin="32,68,0,0"/>

        <!-- PESQUISA -->

        <TextBox x:Name="txtPesquisa"
                 Width="280"
                 Height="38"
                 HorizontalAlignment="Left"
                 Margin="30,105,0,0"
                 VerticalAlignment="Top"
                 Padding="10"
                 TextChanged="txtPesquisa_TextChanged"/>

        <Button Content="Novo usuário"
                Width="140"
                Height="38"
                HorizontalAlignment="Right"
                Margin="0,105,30,0"
                VerticalAlignment="Top"
                Background="#3C848A"
                Foreground="White"
                BorderThickness="0"
                Click="NovoUsuario_Click"/>

        <!-- CARDS -->

        <ScrollViewer Margin="20,160,20,65"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <WrapPanel x:Name="painelCards"
                       HorizontalAlignment="Center"/>

        </ScrollViewer>

        <!-- VOLTAR -->

        <Button Content="Voltar"
                Width="120"
                Height="38"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,15"
                Background="White"
                Foreground="#3C848A"
                BorderBrush="#3C848A"
                Click="Voltar_Click"/>

    </Grid>

</Window>