<Window x:Class="WpfApp1.Auditoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auditoria"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"/>
                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <TextBlock Text="Auditoria"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#263238"
                   Margin="30,25,830,521"/>

        <TextBlock Text="Registro das operações realizadas no sistema."
                   Foreground="#718096"
                   Margin="32,68,721,499"/>

        <Border Background="White"
                CornerRadius="12"
                Margin="30,105,30,70">

            <DataGrid x:Name="gridAuditoria"
                      Margin="10"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"/>

        </Border>

        <Button Content="Voltar"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,15"
                Background="White"
                Foreground="#3C848A"
                BorderBrush="#3C848A"
                Click="Voltar_Click"/>

    </Grid>

</Window>