<Window x:Class="WpfApp1.Auditoria"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Auditoria"
            Height="600"
            Width="1000"
            WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.Background>
            <ImageBrush
        ImageSource="https://images.unsplash.com/photo-1662560884429-ab43eb250446?w=500&amp;auto=format&amp;fit=crop&amp;q=60&amp;ixlib=rb-4.1.0&amp;ixid=M3wxMjA3fDB8MHxzZWFyY2h8MjY1fHxwYXBlbCUyMGRlJTIwcGFyZWRlJTIwZW0lMjB0ZWxhJTIwY2hlaWF8ZW58MHwwfDB8fHwy"
        Stretch="UniformToFill"/>
        </Grid.Background>

        <TextBlock Text="Auditoria"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Black"
                       Margin="30,10,690,519"/>

        <TextBlock Text="Registro das operações realizadas no sistema."
                       Foreground="Black"
                       Margin="30,70,690,474"/>

        <Border x:Name="gridAuditoria1" Background="White"
                    CornerRadius="12"
                    Margin="30,115,30,60">

            <DataGrid x:Name="gridAuditoria"
                          Margin="10,10,10,10"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"/>

        </Border>

        <Button Content="Voltar"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,15"
                    Background="White"
                    Foreground="#3C848A"
                    BorderBrush="#3C848A"
                    Click="Voltar_Click"/>

    </Grid>

</Window>