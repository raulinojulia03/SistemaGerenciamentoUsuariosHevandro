<Window x:Class="WpfApp1.EditarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuário"
        Height="620"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#DCEFF0"/>
                <GradientStop Color="#F5F8F9"
                              Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="650"
                Height="520"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <TextBlock Text="EDITAR USUÁRIO"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#3C848A"
                           Margin="40,25,0,0"/>

                <TextBlock Text="Dados do usuário"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#263238"
                           Margin="40,48,0,0"/>

                <TextBlock Text="Nome completo"
                           Margin="40,105,0,0"/>

                <TextBox x:Name="txtNome"
                         Width="280"
                         Height="38"
                         Margin="40,127,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="Usuário"
                           Margin="40,180,0,0"/>

                <TextBox x:Name="txtUsuario"
                         Width="280"
                         Height="38"
                         Margin="40,202,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="E-mail"
                           Margin="40,255,0,0"/>

                <TextBox x:Name="txtEmail"
                         Width="280"
                         Height="38"
                         Margin="40,277,0,0"
                         HorizontalAlignment="Left"
                         Padding="10"/>

                <TextBlock Text="Tipo"
                           Margin="350,105,0,0"/>

                <ComboBox x:Name="cmbTipo"
                          Width="240"
                          Height="38"
                          Margin="350,127,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="Usuario"/>
                    <ComboBoxItem Content="Administrador"/>

                </ComboBox>

                <TextBlock Text="Status"
                           Margin="350,180,0,0"/>

                <ComboBox x:Name="cmbStatus"
                          Width="240"
                          Height="38"
                          Margin="350,202,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="Ativo"/>
                    <ComboBoxItem Content="Inativo"/>

                </ComboBox>

                <TextBlock Text="Avatar"
                           Margin="350,255,0,0"/>

                <ComboBox x:Name="cmbAvatar"
                          Width="240"
                          Height="38"
                          Margin="350,277,0,0"
                          HorizontalAlignment="Left">

                    <ComboBoxItem Content="avatar01.png"/>
                    <ComboBoxItem Content="avatar02.png"/>
                    <ComboBoxItem Content="avatar03.png"/>
                    <ComboBoxItem Content="avatar04.png"/>
                    <ComboBoxItem Content="avatar05.png"/>

                </ComboBox>

                <Button Content="Salvar"
                        Width="180"
                        Height="42"
                        Margin="40,410,0,0"
                        HorizontalAlignment="Left"
                        Background="#3C848A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Salvar_Click"/>

                <Button Content="Cancelar"
                        Width="180"
                        Height="42"
                        Margin="230,410,0,0"
                        HorizontalAlignment="Left"
                        Background="White"
                        Foreground="#3C848A"
                        BorderBrush="#3C848A"
                        Click="Cancelar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>