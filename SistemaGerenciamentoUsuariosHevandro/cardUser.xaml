<UserControl x:Class="WpfApp1.CardUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260"
             Height="350">

    <Border Background="White"
            CornerRadius="15"
            Padding="15"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="12"
                ShadowDepth="3"
                Opacity="0.15"/>
        </Border.Effect>

        <StackPanel>

            <!-- AVATAR -->
            <Border Width="100"
                    Height="100"
                    CornerRadius="50"
                    HorizontalAlignment="Center"
                    Background="#DCEFF0">

                <Image Source ="https://cdn-icons-png.flaticon.com/128/1040/1040005.png" x:Name="imgAvatar"
                       Stretch="UniformToFill" Margin="5,0,5,10"/>

            </Border>

            <!-- NOME -->
            <TextBlock x:Name="txtNome"
                       Text="Nome"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#263238"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

            <!-- USUARIO -->
            <TextBlock x:Name="txtUsuario"
                       Text="@usuario"
                       FontSize="13"
                       Foreground="#718096"
                       HorizontalAlignment="Center"/>

            <!-- EMAIL -->
            <TextBlock x:Name="txtEmail"
                       Text="email@email.com"
                       FontSize="12"
                       Foreground="#718096"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,5,0,5"/>

            <!-- TIPO -->
            <TextBlock x:Name="txtTipo"
                       Text="Administrador"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#3C848A"
                       HorizontalAlignment="Center"/>

            <!-- STATUS -->
            <TextBlock x:Name="txtStatus"
                       Text="Ativo"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>

            <!-- LOGIN -->
            <TextBlock x:Name="txtUltimoLogin"
                       Text="Nenhum acesso registrado."
                       FontSize="11"
                       Foreground="#718096"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,5,0,8"/>

            <!-- BOTÕES -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

                    <Button x:Name="btnEditar"
            Content="Editar"
            Width="65"
            Height="30"
            Margin="2"
            Background="#3C848A"
            Foreground="White"
            BorderThickness="0"
            Click="Editar_Click"/>

                    <Button x:Name="btnSenha"
            Content="Senha"
            Width="65"
            Height="30"
            Margin="2"
            Background="#718096"
            Foreground="White"
            BorderThickness="0"
            Click="Senha_Click"/>

                    <Button x:Name="btnExcluir"
            Content="Excluir"
            Width="65"
            Height="30"
            Margin="2"
            Background="#C75C5C"
            Foreground="White"
            BorderThickness="0"
            Click="Excluir_Click"/>

                </StackPanel>
            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>